# Resend — required for the contact form API (/api/contact)
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=

# Destination inbox (defaults to admin@delphin.in)
CONTACT_TO=admin@delphin.in

# Verified sender. Until delphin.in is verified in Resend, use:
# Delphin Website <onboarding@resend.dev>
# After verifying the domain, switch to e.g.:
# Delphin <admin@delphin.in>
RESEND_FROM=Delphin Website <onboarding@resend.dev>
